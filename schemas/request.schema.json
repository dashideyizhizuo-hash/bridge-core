{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/bridge/schemas/request.schema.json",
  "title": "Bridge Run Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "repository", "target", "policy", "capability", "parameters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target": { "$ref": "#/$defs/identity" },
    "policy": { "$ref": "#/$defs/identity" },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "parameters": {
      "type": "object"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
