{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/bridge/schemas/batch-result.schema.json",
  "title": "Bridge Batch Run Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "requestId", "repository", "targetRef", "targetSha", "policySha", "requestSha256", "status", "steps", "durationMs", "startedAt", "completedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"const": "batch"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "targetRef": {"type": "string", "minLength": 1, "maxLength": 255},
    "targetSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policySha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectPolicySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["SUCCEEDED", "VERIFIED", "FAILED", "DENIED", "STALE", "CANCELED"]},
    "steps": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/stepResult"}},
    "durationMs": {"type": "integer", "minimum": 0},
    "runner": {"type": "object"},
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["materializations", "shared"],
      "properties": {"materializations": {"const": 1}, "shared": {"const": true}}
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "error": {"$ref": "#/$defs/error"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "treeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "diffSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changedFiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verificationResultSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "VERIFIED"}}},
    "then": {"required": ["baseSha", "candidateSha", "treeSha", "diffSha256", "changedFiles", "verificationResultSha256"]},
    "else": {"not": {"required": ["candidateSha"]}}
  }],
  "$comment": "Terminal evidence only, at most 4194304 bytes UTF-8. Steps preserve request order and IDs. After the first failed/denied/stale/canceled step all remaining steps are SKIPPED. No candidate is publishable except VERIFIED. Error/evidence are untrusted and physical resource roots are redacted.",
  "$defs": {
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}}
    },
    "stepResult": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "status", "durationMs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "type": {"enum": ["exec", "preset", "edit"]},
        "status": {"enum": ["SUCCEEDED", "FAILED", "DENIED", "STALE", "CANCELED", "SKIPPED"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "execution": {"type": "object"},
        "evidence": {"type": "object"},
        "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}
