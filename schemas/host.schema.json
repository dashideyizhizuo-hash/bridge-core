{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/bridge/schemas/host.schema.json",
  "title": "Bridge Host Policy v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "host", "repositories"],
  "properties": {
    "version": { "const": 1 },
    "host": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "repositories": { "type": "object" }
  }
}
