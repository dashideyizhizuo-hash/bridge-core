{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/bridge/schemas/result.schema.json",
  "title": "Bridge Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "requestId", "status", "repository", "targetSha", "policySha", "capability"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string" },
    "status": {
      "enum": ["QUEUED", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "DENIED", "STALE", "CANCELED"]
    },
    "repository": { "type": "string" },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "policySha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capability": { "type": "string" },
    "execution": {
      "type": "object",
      "properties": {
        "exitCode": { "type": ["integer", "null"] },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
