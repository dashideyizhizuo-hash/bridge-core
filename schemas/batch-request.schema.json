{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example/bridge/schemas/batch-request.schema.json",
  "title": "Bridge Batch Run Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "requestId", "repository", "target", "policy", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"const": "batch"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "target": {"$ref": "#/$defs/identity"},
    "policy": {"$ref": "#/$defs/identity"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"oneOf": [{"$ref": "#/$defs/exec"}, {"$ref": "#/$defs/preset"}, {"$ref": "#/$defs/edit"}]}
    },
    "commitSubject": {"type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[^\\r\\n\\u0000]*$"}
  },
  "allOf": [{
    "if": {"properties": {"steps": {"contains": {"properties": {"type": {"const": "edit"}}, "required": ["type"]}}}},
    "then": {"required": ["commitSubject"]},
    "else": {"not": {"required": ["commitSubject"]}}
  }],
  "$comment": "Runtime also enforces unique step IDs, 32768 UTF-8 argv bytes per exec, 4096 UTF-8 bytes per argument, 64 operations across the batch, and 262144 bytes for compact JSON. All steps are authorized before execution. No loops, shell-string field, env overrides or publication step.",
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha"],
      "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 255}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "exec": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "argv"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "type": {"const": "exec"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$"}},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000\\r\\n]).+$"},
        "resources": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$"}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "preset": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "capability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "type": {"const": "preset"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$"},
        "parameters": {"type": "object"}
      }
    },
    "edit": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "operations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "type": {"const": "edit"},
        "operations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"oneOf": [{"$ref": "#/$defs/replaceExact"}, {"$ref": "#/$defs/applyPatch"}]}}
      }
    },
    "replaceExact": {
      "type": "object", "additionalProperties": false, "required": ["type", "path", "oldText", "newText"],
      "properties": {
        "type": {"const": "replace-exact"},
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000\\r\\n]).+$"},
        "oldText": {"type": "string", "minLength": 1},
        "newText": {"type": "string"}
      }
    },
    "applyPatch": {
      "type": "object", "additionalProperties": false, "required": ["type", "patch"],
      "properties": {"type": {"const": "apply-patch"}, "patch": {"type": "string", "minLength": 1}}
    }
  }
}
