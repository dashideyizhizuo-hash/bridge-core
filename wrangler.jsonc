{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridge-control-plane",
  "main": "src/cloudflare/worker-entry.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bridge-auth",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DIRECT_ASSETS",
      "bucket_name": "bridge-direct-assets"
    }
  ],
  "keep_vars": true
}
